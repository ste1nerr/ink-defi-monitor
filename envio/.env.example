# HyperSync API token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# Archive RPC for the hourly reserve snapshots (getReserveData / getAssetPrice /
# symbol / decimals). Defaults to the public Ink RPC, the same one the server uses.
# Comma-separated for fallbacks.
# ENVIO_RPC_URL=https://ink-mainnet.g.alchemy.com/v2/<KEY>
# Optional: stop at a fixed block (used for parity runs).
# ENVIO_END_BLOCK=
