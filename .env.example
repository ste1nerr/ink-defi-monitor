# Ink RPC. Use your Alchemy URL (https://ink-mainnet.g.alchemy.com/v2/<KEY>) in production.
# Falls back to the public Ink RPC when unset.
INK_RPC_URL=
# API server port
PORT=8787
# Allowed browser origin for CORS (the web app)
CORS_ORIGIN=http://localhost:5173
# Goldsky GraphQL endpoint of the Tydro subgraph (indexer/tydro). When unset, Tydro events
# fall back to a recent RPC block window and history endpoints return 503.
GOLDSKY_TYDRO_URL=
